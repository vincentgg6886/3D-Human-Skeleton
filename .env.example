# OrthoVis 3D - Environment Variables
# Copy this file to .env and modify as needed
# Most variables are optional - the app works without them

# App title (optional, defaults to "OrthoVis 3D")
VITE_APP_TITLE=OrthoVis 3D - 骨科3D骨骼交互系统

# App logo URL (optional)
# VITE_APP_LOGO=

# Analytics (optional - Umami analytics)
# VITE_ANALYTICS_ENDPOINT=
# VITE_ANALYTICS_WEBSITE_ID=
